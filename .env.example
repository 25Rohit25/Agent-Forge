# AgentForge Configuration Template

# Application
APP_NAME=AgentForge
ENVIRONMENT=development
PORT=8000
DEBUG=True
SECRET_KEY=agentforge-super-secret-jwt-key-change-in-production-min-32-chars

# LLM Providers
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Database (PostgreSQL with pgvector)
# If PostgreSQL is unavailable, AgentForge seamlessly falls back to local SQLite + in-memory vector index
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentforge
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/agentforge

# Redis Cache & Rate Limiting
# If Redis is unavailable, AgentForge seamlessly falls back to fast in-memory caching
REDIS_URL=redis://localhost:6379/0

# GitHub Integration
# If GITHUB_TOKEN is omitted, AgentForge operates in realistic simulator mode
GITHUB_TOKEN=
GITHUB_REPO=25Rohit25/Agent-Forge

# Slack Integration (Optional Webhook)
SLACK_WEBHOOK_URL=

# Agent Execution Limits
MAX_AGENT_ITERATIONS=10
DEFAULT_TIMEOUT_SECONDS=60
